    transition: 0.3s;
}

.nav a:hover {
    color: #d2691e;
}

/* ---------- Баннер ---------- */
.hero {
    background: linear-gradient(135deg, #ffd7a8 0%, #ffb87a 50%, #ffa858 100%);
    padding: 90px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.hero::after {
    content: "🐾 🐾 🐾";
    position: absolute;
    bottom: 15px;
    right: 30px;
    font-size: 26px;
    opacity: 0.35;
}

.hero h1 {
    font-size: 44px;
    margin-bottom: 20px;
    color: #4a2a0a;
    font-weight: 800;
}

.hero p {
    font-size: 18px;
    max-width: 620px;
    margin: 0 auto 30px;
    color: #6b4a2a;
}

/* ---------- Кнопки ---------- */
.btn {
    display: inline-block;
    background: #d2691e;
    color: #fff;
    padding: 14px 34px;
    border-radius: 30px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    box-shadow: 0 4px 14px rgba(210, 105, 30, 0.4);
    transition: 0.3s;
}

.btn:hover {
    background: #a0522d;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(210, 105, 30, 0.5);
}

.btn-small {
    display: inline-block;
    background: #d2691e;
    color: #fff;
    padding: 9px 20px;
    border-radius: 20px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    margin-top: 14px;
    transition: 0.3s;
}

.btn-small:hover {
    background: #a0522d;
}

/* ---------- Секции ---------- */
.section {
    padding: 80px 0;
}

.section-gray {
    background: #fdf2e3;
}

.section h2 {
    font-size: 34px;
    margin-bottom: 45px;
    text-align: center;
    color: #4a2a0a;
    font-weight: 800;
}

.section h2::after {
    content: "";
    display: block;
    width: 60px;
    height: 4px;
    background: #d2691e;
    margin: 15px auto 0;
    border-radius: 2px;
}

/* ---------- Карточки кошек ---------- */
.cats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 28px;
}

.cat-card {
    background: #fff;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 5px 18px rgba(210, 105, 30, 0.12);
    transition: 0.3s;
    border: 2px solid #ffe8cc;
}

.cat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(210, 105, 30, 0.25);
    border-color: #ffb87a;
}

/* Фото кошки — теперь настоящая картинка */
.cat-photo {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    background: #ffe4c4;
}

/* Заглушка, если фото нет */
.cat-photo-placeholder {
    height: 220px;
    background: linear-gradient(135deg, #ffe4c4, #ffd1a4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
}

.cat-info {
    padding: 22px;
}

.cat-info h3 {
    font-size: 23px;
    margin-bottom: 6px;
    color: #4a2a0a;
}

.cat-meta {
    font-size: 13px;
    color: #b08050;
    margin-bottom: 10px;
    font-weight: 600;
}

.cat-desc {
    font-size: 15px;
    color: #5a4a3a;
}

/* ---------- Шаги ---------- */
.steps {
    max-width: 620px;
    margin: 0 auto;
    font-size: 17px;
    list-style: none;
    counter-reset: step;
}

.steps li {
    margin-bottom: 18px;
    padding: 18px 20px 18px 70px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 3px 12px rgba(210, 105, 30, 0.1);
    position: relative;
    counter-increment: step;
}

.steps li::before {
    content: counter(step);
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    background: #d2691e;
    color: #fff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 17px;
}

/* ---------- Помощь ---------- */
.help-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.help-item {
    background: #fff;
    padding: 28px 22px;
    border-radius: 16px;
    box-shadow: 0 4px 14px rgba(210, 105, 30, 0.1);
    text-align: center;
    transition: 0.3s;
    border-top: 4px solid #d2691e;
}

.help-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 22px rgba(210, 105, 30, 0.2);
}

.help-item h3 {
    margin-bottom: 10px;
    color: #d2691e;
    font-size: 19px;
}

/* ---------- Контакты ---------- */
#contacts p {
    text-align: center;
    font-size: 17px;
    margin-bottom: 8px;
    color: #5a4a3a;
}

/* ---------- Подвал ---------- */
.footer {
    background: #4a2a0a;
    color: #ffd7a8;
    text-align: center;
    padding: 28px 0;
    font-size: 14px;
}

/* ---------- Мобильная адаптация ---------- */
@media (max-width: 700px) {
    .header-inner {
        flex-direction: column;
        gap: 12px;
    }
    .nav a {
        margin: 0 8px;
        font-size: 14px;
    }
    .hero h1 {
        font-size: 28px;
    }
    .hero {
        padding: 55px 0;
    }
    .section h2 {
        font-size: 25px;
    }
}
